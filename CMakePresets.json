{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "$env{NL_TMP_BASE}/notalivre-build/${presetName}",
      "condition": { "type": "notEquals", "lhs": "$env{NL_TMP_BASE}", "rhs": "" },
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" },
      "environment": { "TMPDIR": "$env{NL_TMP_BASE}" }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug (assert ativo)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release (assert desligado, NDEBUG)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "asan-ubsan",
      "inherits": "base",
      "displayName": "Debug + AddressSanitizer + UBSan (sem recuperação)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "banco",
      "inherits": "debug",
      "displayName": "Debug com os testes de banco (harness NL-3.1h)",
      "cacheVariables": { "NL_TESTES_BANCO": "ON" }
    },
    {
      "name": "banco-asan",
      "inherits": "asan-ubsan",
      "displayName": "Debug + ASan/UBSan com os testes de banco (harness NL-3.1a, sanitizer)",
      "cacheVariables": { "NL_TESTES_BANCO": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" },
    { "name": "banco", "configurePreset": "banco" },
    { "name": "banco-asan", "configurePreset": "banco-asan" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    {
      "name": "banco",
      "configurePreset": "banco",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "^banco$" } }
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "output": { "outputOnFailure": true },
      "environment": {
        "ASAN_OPTIONS": "halt_on_error=1:detect_leaks=1:exitcode=86",
        "LSAN_OPTIONS": "detect_leaks=1:exitcode=86",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1:exitcode=86"
      }
    },
    {
      "name": "banco-asan",
      "configurePreset": "banco-asan",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "^banco$" } },
      "environment": {
        "ASAN_OPTIONS": "halt_on_error=1:detect_leaks=1:exitcode=86",
        "LSAN_OPTIONS": "detect_leaks=1:exitcode=86",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1:exitcode=86"
      }
    }
  ]
}
